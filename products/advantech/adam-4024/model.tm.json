{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "modpoll": "https://top-maker.github.io/modpoll/vocab/wot-modbus#",
      "modv": "https://www.w3.org/2019/wot/modbus",
      "xsd": "http://www.w3.org/2001/XMLSchema#"
    }
  ],
  "@type": "tm:ThingModel",
  "title": "Advantech ADAM-4024 4-Channel Analog Output Module",
  "description": "Thing Model for the Advantech ADAM-4024 RS-485 analog output module in Modbus RTU mode. It reads the four emergency digital input flags, the four analog output values, the module name, the firmware version words and the communication safety status. Addresses follow the ADAM-4000 Series User Manual Ed. 9, Appendix G.1 (0X coils and 4X holding registers). Output values are raw words without engineering-unit conversion and are read only. The module must be configured for Modbus RTU rather than ADAM ASCII. Firmware is not stated, and the manual edition predates the ADAM-4024-C order code; confirm output ranges and data format on the device. No hardware validation is claimed.",
  "modpoll:version": "0.2",
  "properties": {
    "EMERGENCY_DI0": {
      "type": "boolean",
      "description": "Emergency digital input flag of channel 0, coil 00001.",
      "readOnly": true,
      "forms": [
        {
          "op": "readproperty",
          "contentType": "application/octet-stream",
          "modv:entity": "Coil",
          "modv:address": 0,
          "modv:quantity": 1,
          "modv:type": "xsd:boolean"
        }
      ]
    },
    "EMERGENCY_DI1": {
      "type": "boolean",
      "description": "Emergency digital input flag of channel 1, coil 00002.",
      "readOnly": true,
      "forms": [
        {
          "op": "readproperty",
          "contentType": "application/octet-stream",
          "modv:entity": "Coil",
          "modv:address": 1,
          "modv:quantity": 1,
          "modv:type": "xsd:boolean"
        }
      ]
    },
    "EMERGENCY_DI2": {
      "type": "boolean",
      "description": "Emergency digital input flag of channel 2, coil 00003.",
      "readOnly": true,
      "forms": [
        {
          "op": "readproperty",
          "contentType": "application/octet-stream",
          "modv:entity": "Coil",
          "modv:address": 2,
          "modv:quantity": 1,
          "modv:type": "xsd:boolean"
        }
      ]
    },
    "EMERGENCY_DI3": {
      "type": "boolean",
      "description": "Emergency digital input flag of channel 3, coil 00004.",
      "readOnly": true,
      "forms": [
        {
          "op": "readproperty",
          "contentType": "application/octet-stream",
          "modv:entity": "Coil",
          "modv:address": 3,
          "modv:quantity": 1,
          "modv:type": "xsd:boolean"
        }
      ]
    },
    "AO0_RAW": {
      "type": "integer",
      "description": "Analog output channel 0 current output value, holding register 40001. Raw word; the scale depends on the configured output range.",
      "readOnly": true,
      "minimum": 0,
      "maximum": 65535,
      "unit": "count",
      "forms": [
        {
          "op": "readproperty",
          "contentType": "application/octet-stream",
          "modv:entity": "HoldingRegister",
          "modv:address": 0,
          "modv:quantity": 1,
          "modv:type": "xsd:unsignedShort"
        }
      ]
    },
    "AO1_RAW": {
      "type": "integer",
      "description": "Analog output channel 1 current output value, holding register 40002. Raw word; the scale depends on the configured output range.",
      "readOnly": true,
      "minimum": 0,
      "maximum": 65535,
      "unit": "count",
      "forms": [
        {
          "op": "readproperty",
          "contentType": "application/octet-stream",
          "modv:entity": "HoldingRegister",
          "modv:address": 1,
          "modv:quantity": 1,
          "modv:type": "xsd:unsignedShort"
        }
      ]
    },
    "AO2_RAW": {
      "type": "integer",
      "description": "Analog output channel 2 current output value, holding register 40003. Raw word; the scale depends on the configured output range.",
      "readOnly": true,
      "minimum": 0,
      "maximum": 65535,
      "unit": "count",
      "forms": [
        {
          "op": "readproperty",
          "contentType": "application/octet-stream",
          "modv:entity": "HoldingRegister",
          "modv:address": 2,
          "modv:quantity": 1,
          "modv:type": "xsd:unsignedShort"
        }
      ]
    },
    "AO3_RAW": {
      "type": "integer",
      "description": "Analog output channel 3 current output value, holding register 40004. Raw word; the scale depends on the configured output range.",
      "readOnly": true,
      "minimum": 0,
      "maximum": 65535,
      "unit": "count",
      "forms": [
        {
          "op": "readproperty",
          "contentType": "application/octet-stream",
          "modv:entity": "HoldingRegister",
          "modv:address": 3,
          "modv:quantity": 1,
          "modv:type": "xsd:unsignedShort"
        }
      ]
    },
    "MODULE_NAME_1": {
      "type": "integer",
      "description": "Module name word 1 from holding register 40211; documented as 0x4024.",
      "readOnly": true,
      "minimum": 0,
      "maximum": 65535,
      "unit": "count",
      "forms": [
        {
          "op": "readproperty",
          "contentType": "application/octet-stream",
          "modv:entity": "HoldingRegister",
          "modv:address": 210,
          "modv:quantity": 1,
          "modv:type": "xsd:unsignedShort"
        }
      ]
    },
    "MODULE_NAME_2": {
      "type": "integer",
      "description": "Module name word 2 from holding register 40212; documented as 0x0000.",
      "readOnly": true,
      "minimum": 0,
      "maximum": 65535,
      "unit": "count",
      "forms": [
        {
          "op": "readproperty",
          "contentType": "application/octet-stream",
          "modv:entity": "HoldingRegister",
          "modv:address": 211,
          "modv:quantity": 1,
          "modv:type": "xsd:unsignedShort"
        }
      ]
    },
    "VERSION_1": {
      "type": "integer",
      "description": "Firmware version word 1 from holding register 40213; the manual's example is 0xA200.",
      "readOnly": true,
      "minimum": 0,
      "maximum": 65535,
      "unit": "count",
      "forms": [
        {
          "op": "readproperty",
          "contentType": "application/octet-stream",
          "modv:entity": "HoldingRegister",
          "modv:address": 212,
          "modv:quantity": 1,
          "modv:type": "xsd:unsignedShort"
        }
      ]
    },
    "VERSION_2": {
      "type": "integer",
      "description": "Firmware version word 2 from holding register 40214.",
      "readOnly": true,
      "minimum": 0,
      "maximum": 65535,
      "unit": "count",
      "forms": [
        {
          "op": "readproperty",
          "contentType": "application/octet-stream",
          "modv:entity": "HoldingRegister",
          "modv:address": 213,
          "modv:quantity": 1,
          "modv:type": "xsd:unsignedShort"
        }
      ]
    },
    "COMM_SAFETY_ENABLE": {
      "type": "integer",
      "description": "Communication safety setting from holding register 40215; 1 when enabled.",
      "readOnly": true,
      "minimum": 0,
      "maximum": 65535,
      "unit": "count",
      "forms": [
        {
          "op": "readproperty",
          "contentType": "application/octet-stream",
          "modv:entity": "HoldingRegister",
          "modv:address": 214,
          "modv:quantity": 1,
          "modv:type": "xsd:unsignedShort"
        }
      ]
    },
    "COMM_SAFETY_FLAG": {
      "type": "integer",
      "description": "Communication safety flag from holding register 40216; 1 when a communication timeout occurred.",
      "readOnly": true,
      "minimum": 0,
      "maximum": 65535,
      "unit": "count",
      "forms": [
        {
          "op": "readproperty",
          "contentType": "application/octet-stream",
          "modv:entity": "HoldingRegister",
          "modv:address": 215,
          "modv:quantity": 1,
          "modv:type": "xsd:unsignedShort"
        }
      ]
    }
  },
  "modpoll:acquisition": [
    {
      "modv:entity": "Coil",
      "modv:address": 0,
      "modv:quantity": 4,
      "modpoll:members": [
        "EMERGENCY_DI0",
        "EMERGENCY_DI1",
        "EMERGENCY_DI2",
        "EMERGENCY_DI3"
      ]
    },
    {
      "modv:entity": "HoldingRegister",
      "modv:address": 0,
      "modv:quantity": 4,
      "modpoll:members": [
        "AO0_RAW",
        "AO1_RAW",
        "AO2_RAW",
        "AO3_RAW"
      ]
    },
    {
      "modv:entity": "HoldingRegister",
      "modv:address": 210,
      "modv:quantity": 6,
      "modpoll:members": [
        "MODULE_NAME_1",
        "MODULE_NAME_2",
        "VERSION_1",
        "VERSION_2",
        "COMM_SAFETY_ENABLE",
        "COMM_SAFETY_FLAG"
      ]
    }
  ]
}

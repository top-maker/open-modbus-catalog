{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "modpoll": "https://top-maker.github.io/modpoll/vocab/wot-modbus#",
      "modv": "https://www.w3.org/2019/wot/modbus",

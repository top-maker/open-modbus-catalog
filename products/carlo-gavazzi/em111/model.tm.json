  "@type": "tm:ThingModel",
  "title": "Carlo Gavazzi EM111 Single-Phase Energy Meter",
  "description": "Thing Model for the Carlo Gavazzi EM111 single-phase energy meter with the S1 RS-485 Modbus RTU port. It reads voltage, current, active, apparent and reactive power, power factor, frequency, imported and exported energy totals, partial and tariff energies, demand power, the identification code and the firmware version and revision. Addresses follow the EM100 Series and ET100 Series Modbus Communication Protocol v4.0 of 2025-06-20; 32-bit values are low word first, and a request reads at most 50 registers. Table 4.1 lists W dmd at 000Ah over two words while Table 4.7 puts the identification code at 000Bh, so demand power is read from its Table 4.2 copy. Rows marked not available are omitted. Firmware is not stated; the M-Bus versions (M1) are different products. No hardware validation is claimed.",
  "modpoll:version": "0.2",
  "properties": {
    "VOLTAGE": {
      "type": "number",
      "description": "Voltage L-N, input registers 300001–300002 (Table 4.1, INT32 low word first, value V×10).",
      "readOnly": true,
      "unit": "V",
      "forms": [
        {
          "op": "readproperty",
          "contentType": "application/octet-stream",
          "modv:entity": "InputRegister",
          "modv:address": 0,
          "modv:quantity": 2,
          "modv:type": "xsd:int",
          "modv:mostSignificantWord": false,
          "modpoll:multiplier": "0.1"
        }
      ]
    },
    "CURRENT": {

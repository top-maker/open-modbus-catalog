{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open Modbus Catalog manufacturers",
  "description": "Maps each manufacturer ID to its display names.",
  "type": "object",
  "minProperties": 1,
  "propertyNames": {
    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
  },
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name"
    ],
    "properties": {
      "name": {
        "$ref": "#/$defs/label"
      },
      "translations": {
        "type": "object",
        "propertyNames": {
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/label"
            }
          }
        }
      },
      "website": {
        "type": "string",
        "pattern": "^https://[^\\s/]+(/[^\\s]*)?$"
      }
    }
  },
  "$defs": {
    "label": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(.*\\S)?$"
    }
  }
}

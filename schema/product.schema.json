{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open Modbus Catalog product record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "manufacturer",
    "modelNumber",
    "aliases",
    "category",
    "description",
    "communication",
    "documents"
  ],
  "properties": {
    "schemaVersion": {
      "const": 4
    },
    "id": {
      "description": "Stable product ID equal to the package path under products/.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*/[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "manufacturer": {
      "$ref": "#/$defs/label"
    },
    "modelNumber": {
      "description": "The manufacturer's model number, such as ADAM-5017UH.",
      "$ref": "#/$defs/label"
    },
    "aliases": {
      "description": "Other spellings of the model number used in search.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/label"
      }
    },
    "category": {
      "$ref": "#/$defs/slug"
    },
    "description": {
      "$ref": "#/$defs/description"
    },
    "translations": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description"
        ],
        "properties": {
          "description": {
            "$ref": "#/$defs/description"
          }
        }
      }
    },
    "specs": {
      "description": "Ordered public specifications cited from the listed documents.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "value"
        ],
        "properties": {
          "label": {
            "$ref": "#/$defs/label"
          },
          "value": {
            "$ref": "#/$defs/label"
          }
        }
      }
    },
    "communication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocols",
        "firmware"
      ],
      "properties": {
        "protocols": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "modbus-tcp",
              "modbus-rtu",
              "modbus-ascii"
            ]
          }
        },
        "viaChassis": {
          "description": "Chassis or gateway that provides Modbus communication for a backplane module.",
          "$ref": "#/$defs/label"
        },
        "firmware": {
          "description": "Documented firmware applicability, or null if unknown.",
          "anyOf": [
            {
              "$ref": "#/$defs/label"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "title",
          "reference"
        ],
        "oneOf": [
          {
            "required": [
              "url"
            ]
          },
          {
            "required": [
              "path"
            ]
          }
        ],
        "properties": {
          "type": {
            "enum": [
              "datasheet",
              "manual",
              "other"
            ]
          },
          "title": {
            "$ref": "#/$defs/label"
          },
          "reference": {
            "$ref": "#/$defs/label"
          },
          "url": {
            "$ref": "#/$defs/httpsUrl"
          },
          "path": {
            "type": "string",
            "pattern": "^documents/[a-z0-9]+(?:-[a-z0-9]+)*\\.pdf$"
          },
          "rights": {
            "$ref": "#/$defs/label"
          }
        },
        "dependentRequired": {
          "path": [
            "rights"
          ]
        }
      }
    },
    "images": {
      "type": "array",
      "maxItems": 99,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "alt",
          "view",
          "source",
          "rights"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^images/(?:0[1-9]|[1-9][0-9])\\.svg$"
          },
          "alt": {
            "$ref": "#/$defs/label"
          },
          "translations": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "alt"
              ],
              "properties": {
                "alt": {
                  "$ref": "#/$defs/label"
                }
              }
            }
          },
          "view": {
            "$ref": "#/$defs/label"
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "rights": {
            "$ref": "#/$defs/label"
          }
        }
      }
    },
    "thingModels": {
      "description": "Executable baseline Thing Models in this package.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "scope"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^models/[a-z0-9]+(-[a-z0-9]+)*\\.tm\\.json$"
          },
          "scope": {
            "description": "Hardware, chassis and firmware the point mappings apply to, and its documentary basis.",
            "$ref": "#/$defs/label"
          },
          "vectors": {
            "description": "Known raw values per property for the simulation round trip.",
            "type": "string",
            "pattern": "^models/[a-z0-9]+(-[a-z0-9]+)*\\.vectors\\.json$"
          },
          "scenarios": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^simulation/[a-z0-9]+(-[a-z0-9]+)*\\.sim\\.json$"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "label": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(.*\\S)?$"
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[^\\s/]+(/[^\\s]*)?$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "reference"
      ],
      "properties": {
        "url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "reference": {
          "$ref": "#/$defs/label"
        }
      }
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^<>\\x00-\\x1f\\x7f]+$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open Modbus Catalog product record (product.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "modelNumber",
    "category",
    "description",
    "communication",
    "documents"
  ],
  "properties": {
    "modelNumber": {
      "description": "The manufacturer's model number, such as ADAM-5017UH.",
      "$ref": "#/$defs/label"
    },
    "aliases": {
      "description": "Other spellings of the model number used in search. Defaults to none.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/label"
      }
    },
    "category": {
      "description": "A category ID listed in categories.yaml.",
      "$ref": "#/$defs/slug"
    },
    "description": {
      "$ref": "#/$defs/description"
    },
    "translations": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description"
        ],
        "properties": {
          "description": {
            "$ref": "#/$defs/description"
          }
        }
      }
    },
    "specs": {
      "description": "Ordered public specifications cited from the listed documents.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "value"
        ],
        "properties": {
          "label": {
            "$ref": "#/$defs/label"
          },
          "value": {
            "$ref": "#/$defs/label"
          }
        }
      }
    },
    "communication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocols"
      ],
      "properties": {
        "protocols": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "modbus-tcp",
              "modbus-rtu",
              "modbus-ascii"
            ]
          }
        },
        "viaChassis": {
          "description": "Chassis or gateway that provides Modbus communication for a backplane module.",
          "$ref": "#/$defs/label"
        },
        "firmware": {
          "description": "Documented firmware applicability. Absent when unknown.",
          "$ref": "#/$defs/label"
        },
        "defaults": {
          "description": "Documented communication settings a new device ships with, per transport. Record only values the cited documents state.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference"
          ],
          "minProperties": 2,
          "properties": {
            "tcp": {
              "description": "Modbus TCP settings. An absent port means the Modbus standard port 502.",
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "unitId": {
                  "$ref": "#/$defs/unitId"
                }
              }
            },
            "serial": {
              "description": "Modbus RTU or ASCII settings on the serial line.",
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "unitId": {
                  "$ref": "#/$defs/unitId"
                },
                "baudRate": {
                  "type": "integer",
                  "minimum": 300,
                  "maximum": 921600
                },
                "dataBits": {
                  "enum": [
                    7,
                    8
                  ]
                },
                "parity": {
                  "enum": [
                    "none",
                    "even",
                    "odd"
                  ]
                },
                "stopBits": {
                  "enum": [
                    1,
                    2
                  ]
                }
              }
            },
            "reference": {
              "description": "Document title and exact sections or pages that state these settings, and any step needed before Modbus is available.",
              "$ref": "#/$defs/label"
            }
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "title",
          "reference"
        ],
        "oneOf": [
          {
            "required": [
              "url"
            ]
          },
          {
            "required": [
              "path"
            ]
          }
        ],
        "properties": {
          "type": {
            "enum": [
              "datasheet",
              "protocol",
              "manual",
              "other"
            ]
          },
          "title": {
            "$ref": "#/$defs/label"
          },
          "reference": {
            "$ref": "#/$defs/label"
          },
          "url": {
            "$ref": "#/$defs/httpsUrl"
          },
          "path": {
            "type": "string",
            "pattern": "^documents/[a-z0-9]+(?:-[a-z0-9]+)*\\.pdf$"
          },
          "rights": {
            "$ref": "#/$defs/label"
          }
        },
        "dependentRequired": {
          "path": [
            "rights"
          ]
        }
      }
    },
    "images": {
      "type": "array",
      "maxItems": 99,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "alt",
          "view",
          "source",
          "rights"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^images/(?:0[1-9]|[1-9][0-9])\\.svg$"
          },
          "alt": {
            "$ref": "#/$defs/label"
          },
          "translations": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "alt"
              ],
              "properties": {
                "alt": {
                  "$ref": "#/$defs/label"
                }
              }
            }
          },
          "view": {
            "$ref": "#/$defs/label"
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "rights": {
            "$ref": "#/$defs/label"
          }
        }
      }
    }
  },
  "$defs": {
    "label": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(.*\\S)?$"
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[^\\s/]+(/[^\\s]*)?$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "reference"
      ],
      "properties": {
        "url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "reference": {
          "$ref": "#/$defs/label"
        }
      }
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^<>\\x00-\\x1f\\x7f]+$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "unitId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    }
  },
  "description": "The product ID is the package path products/<manufacturer ID>/<model number slug>/; the manufacturer is its first segment, listed in manufacturers.yaml. model.tm.json and model.data.json next to product.yaml are the baseline Thing Model and its simulation data."
}
